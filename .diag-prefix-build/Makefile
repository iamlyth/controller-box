test_ip_server: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 test_ip_server
.PHONY : test_ip_server

# fast build rule for target.
test_ip_server/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_ip_server.dir/build.make CMakeFiles/test_ip_server.dir/build
.PHONY : test_ip_server/fast

