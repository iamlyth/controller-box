#ifndef CONTROLLER_BOX_CONFIG_H
#define CONTROLLER_BOX_CONFIG_H

/*
 * config.h — generated by CMake from config.h.in at configure time.
 * Compile-time install paths and build metadata. Runtime path
 * resolution (XDG, $HOME) lives in src/config/config_paths.c.
 */

#define CONTROLLER_BOX_VERSION "@PROJECT_VERSION@"

/* System data directory: icons + icon mapping table (read-only). */
#define DATA_DIR "@CBX_DATA_DIR@"

/* Installed SVG controller icons (read-only). */
#define ICON_DIR "@CBX_ICON_DIR@"

/* Source-tree icon directory — fallback for development builds before
 * `cmake --install`.  SVGs are at ${SOURCE_ICON_DIR}/svg/. */
#define SOURCE_ICON_DIR "@CMAKE_CURRENT_SOURCE_DIR@/data/icons"
#define SOURCE_DATA_DIR "@CMAKE_CURRENT_SOURCE_DIR@/data"

/* Bundled font directory: ${DATA_DIR}/fonts (read-only).  Intended for
 * future bundled fonts; runtime discovery also checks system font
 * directories via cbx_font_path() in config_paths.c. */
#define FONT_DIR "@CBX_FONT_DIR@"

/* Immutable Controller-Box profile assets. */
#define BUILTIN_PROFILE_DIR "@CBX_PROFILE_DIR@"
#define SOURCE_PROFILE_DIR "@CMAKE_CURRENT_SOURCE_DIR@/data/profiles"

/* Installed binary path (used for systemd unit generation). */
#define CBX_BINARY_PATH "@CBX_BINARY_PATH@"

/* Default user config directory ($XDG_CONFIG_HOME/controller-box or
 * ~/.config/controller-box). The actual resolved path is computed at
 * runtime in config_paths.c; this is the fallback default. */
#define CONFIG_DIR ".config/controller-box"

/* System InputPlumber data (read-only). */
#define INPUTPLUMBER_SYSTEM_DATA_DIR "/usr/share/inputplumber"

/* Default user profile directory ($XDG_DATA_HOME/inputplumber/profiles
 * or ~/.local/share/inputplumber/profiles). Resolved at runtime. */
#define INPUTPLUMBER_USER_PROFILES_DIR ".local/share/inputplumber/profiles"

#endif /* CONTROLLER_BOX_CONFIG_H */