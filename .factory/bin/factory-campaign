#!/nix/store/bwry105g7v5jspr41bx9x3fcfqsmfkq2-bash-interactive-5.3p15/bin/bash
# Installed-copy production campaign entrypoint.  The package alias points
# only at this external prefix, so campaign.py can prove its executing install
# manifest/commit before any model role launches.
set -euo pipefail

root=$(cd -- "$(/nix/store/di26b1kkbammy0sj70nq5qzvfrh78wxl-coreutils-9.11/bin/dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
[[ -f "$root/.factory/loop/campaign.py" ]] || {
    echo "factory-campaign: installed campaign control plane is missing: $root" >&2
    exit 1
}
runtime=${FACTORY_INSTALL_RUNTIME:-${TMPDIR:-/tmp}}
alias_dir=$(/nix/store/di26b1kkbammy0sj70nq5qzvfrh78wxl-coreutils-9.11/bin/mktemp -d "${runtime%/}/factory-campaign-alias.XXXXXX") || {
    echo "factory-campaign: cannot create installed package alias" >&2
    exit 1
}
cleanup() { /nix/store/di26b1kkbammy0sj70nq5qzvfrh78wxl-coreutils-9.11/bin/rm -rf -- "$alias_dir"; }
trap cleanup EXIT INT TERM HUP
/nix/store/di26b1kkbammy0sj70nq5qzvfrh78wxl-coreutils-9.11/bin/ln -s -- "$root/.factory" "$alias_dir/factory"
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$alias_dir" \
    /nix/store/miscphl6g76fp89z2drc18dckh2cx9ky-python3-3.13.14/bin/python3 -m factory.loop.campaign "$@"
