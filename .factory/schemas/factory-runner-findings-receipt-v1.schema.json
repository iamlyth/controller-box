{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-runner-findings-receipt-v1.schema.json",
  "title": "Namespaced signed runner findings receipt with retained artifacts",
  "description": "Sibling of factory-runner-receipt-v3: signs the fact that every declared probe EXECUTED to completion inside the bounded sandbox (timed_out=false, cleanup proven, before==after host state, source unchanged) and that its verdict was not a clean pass. A findings receipt proves execution and retained-product-findings, never capability acceptance: it can never satisfy a capability-evidence, conformance, or final gate (those accept only factory-runner-receipt/v3 result=pass records). Infrastructure failures (transport, integrity, timeout, cleanup-unproven, source-changed, skip/simulation markers, unsigned content) produce a factory-runner-error envelope or an integrity failure and are never signable as findings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result", "runner", "commit", "tree", "environment_blob", "archive_sha256", "campaign_id", "readiness_nonce", "authority_sha256", "nonce", "capabilities", "probes", "skip_marker_detected", "exit_code", "timed_out", "started_at", "finished_at", "cleanup", "stdout_sha256", "stderr_sha256", "artifact_protocol", "artifact_limits", "artifact_count", "artifact_bytes", "artifact_manifest_sha256", "artifact_scope_sha256", "artifacts", "host_authority", "signer_principal", "signer_key_sha256", "namespace", "signature_algorithm"],
  "properties": {
    "schema": {"const": "factory-runner-findings-receipt/v1"},
    "result": {"const": "findings"},
    "runner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
    "readiness_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exit_code": {"type": "integer", "minimum": 1},
    "timed_out": {"const": false},
    "cleanup": {"const": true},
    "skip_marker_detected": {"const": false},
    "namespace": {"const": "factory-runner-receipt"},
    "signature_algorithm": {"const": "ssh-ed25519"},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "exit_code", "timed_out"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "exit_code": {"type": "integer", "minimum": 0},
          "timed_out": {"const": false}
        }
      }
    },
    "artifacts": {"type": "array", "maxItems": 128},
    "host_authority": {"type":"object","additionalProperties":false,"required":["executable_pins","writable_limits","inputplumber_pin","dbus_audit_sha256","dbus_audit_descriptor","target_consumer_operation","cleanup_states"],"properties":{"executable_pins":{"type":"object","minProperties":1},"writable_limits":{"const":{"bytes":805306368,"inodes":65536}},"inputplumber_pin":{"type":["object","null"]},"dbus_audit_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"dbus_audit_descriptor":{"type":["object","null"]},"target_consumer_operation":{"type":["object","null"]},"cleanup_states":{"type":"array"}}},
    "artifact_count": {"type": "integer", "minimum": 0, "maximum": 128},
    "artifact_bytes": {"type": "integer", "minimum": 0, "maximum": 50331648},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signer_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signer_principal": {"type": "string"},
    "artifact_protocol": {"const": "factory-runner-artifacts/v1"},
    "artifact_limits": {"type": "object"},
    "started_at": {"type": "integer", "minimum": 0},
    "finished_at": {"type": "integer", "minimum": 0}
  }
}
