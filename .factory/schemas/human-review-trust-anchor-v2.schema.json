{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controller-human-review-trust-anchor/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "namespace", "scope", "keys"],
  "properties": {
    "schema": {"const": "controller-human-review-trust-anchor/v2"},
    "status": {"const": "active"},
    "namespace": {"const": "controller-box-production-graphics-approval"},
    "scope": {"const": "production-human-review"},
    "keys": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "reviewer", "public_key"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"}
        }
      }
    }
  }
}
