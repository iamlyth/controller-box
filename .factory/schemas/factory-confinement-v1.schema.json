{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-confinement/v1",
  "title": "factory confinement specification",
  "description": "The per-launch model workspace/tool confinement specification (FACTORY-LOOP-SPEC sections 5.1/18; Task 8, schema factory-confinement/v1). Each deny-by-default rule binds path text plus dev/inode/type/owner/link-count identity. The trusted parent opens every component with no-follow descriptor-relative resolution and passes the retained descriptors to the staged confined-launch child; the child validates their identities and feeds only those descriptors to Landlock, never reopening a validated rule pathname. The real proof binds the canonical specification digest and LaunchSupervision revalidates proof and descriptors immediately before exec.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "role",
    "provider",
    "workspace",
    "bound_commit",
    "backend",
    "home",
    "env",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "factory-confinement/v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "role": {
      "type": "string",
      "enum": ["planner", "developer", "tester", "auditor"]
    },
    "provider": { "type": "string", "minLength": 1 },
    "workspace": { "type": "string", "minLength": 1 },
    "bound_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "backend": { "type": "string", "minLength": 1 },
    "home": { "type": "string", "minLength": 1 },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["HOME"]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "access", "identity"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "access": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["read", "write", "execute"]
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dev", "ino", "type", "uid", "nlink"],
            "properties": {
              "dev": { "type": "integer", "minimum": 0 },
              "ino": { "type": "integer", "minimum": 0 },
              "type": { "type": "integer", "minimum": 0 },
              "uid": { "type": "integer", "minimum": 0 },
              "nlink": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
