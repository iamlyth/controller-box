{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-runner-findings-aggregate-v1.schema.json",
  "title": "Exact-commit signed runner execution aggregate with per-runner verdicts",
  "description": "Sibling of factory-runner-aggregate-v4 for the executed-product-findings baseline. Written by the coordinator-owned client only when every declared runner completed with a validated signed receipt in the same campaign/readiness/runner/commit/nonce evidence namespace and no transport/integrity or error-envelope failure occurred. Each record's manifest path references a signed receipt whose result is exactly the record's result field (\"pass\" for factory-runner-receipt/v3, \"findings\" for factory-runner-findings-receipt/v1); a findings record proves execution of every declared probe of that runner (timed_out=false, cleanup=true, no skip/simulation markers) with non-pass verdicts, and can never satisfy capability-evidence, conformance, or final acceptance gates. At least one record must carry result \"findings\" for this aggregate to be legitimate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "readiness_nonce", "commit", "tree", "environment_blob", "runners"],
  "properties": {
    "schema": {"const": "factory-runner-findings-aggregate/v1"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
    "readiness_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "manifest", "manifest_sha256", "result", "capabilities", "probes", "artifact_manifest_sha256", "artifact_count", "artifact_bytes", "signer"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "manifest": {"type": "string", "pattern": "^\\.factory-state/runner-evidence/[^/]+/[^/]+/[^/]+/[^/]+/[^/]+/manifest\\.json$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"enum": ["pass", "findings"]},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "probes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability", "exit_code", "timed_out"],
              "properties": {
                "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
                "exit_code": {"type": "integer", "minimum": 0},
                "timed_out": {"const": false}
              }
            }
          },
          "artifact_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact_count": {"type": "integer", "minimum": 0, "maximum": 128},
          "artifact_bytes": {"type": "integer", "minimum": 0, "maximum": 50331648},
          "signer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["principal", "key_sha256", "algorithm", "signature_sha256"],
            "properties": {
              "principal": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
              "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "algorithm": {"const": "ssh-ed25519"},
              "signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
