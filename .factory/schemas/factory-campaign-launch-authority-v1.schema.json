{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-campaign-launch-authority/v1",
  "title": "Authenticated immutable production campaign launch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign_id", "provider", "model", "backend",
    "accepted_commit", "branch", "rounds_requested", "state_namespace",
    "prompt_set_digest", "specification_digest", "audit_objectives_digest",
    "pre_round_hook_configuration_digest", "install_manifest",
    "human_trust_anchor_sha256", "verification_command",
    "capability_command", "acceptance_command", "runner_command", "mac"
  ],
  "properties": {
    "schema": {"const": "factory-campaign-launch-authority/v1"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
    "provider": {"enum": ["ollama", "openai-codex"]},
    "model": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "pattern": "^/"},
    "accepted_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "rounds_requested": {"const": 5},
    "state_namespace": {"type": "string", "minLength": 1},
    "prompt_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "specification_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_objectives_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pre_round_hook_configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "install_manifest": {"type": "string", "minLength": 1},
    "human_trust_anchor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capability_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runner_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
