{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-readiness-result/v3",
  "$comment": "This document is an unauthoritative cache. Authorization is derived by reopening canonical campaign state and source evidence; digest-shaped values alone are never authority. Versioned sibling of factory-readiness-result/v2 (retained as legacy reference): adds the infrastructure_ready/plannable pair and the two digest-bound product-findings fields. A complete/pass readiness requires both findings digests to be zero; an infrastructure_ready readiness requires a validated runner digest (aggregate OR findings_aggregate), execution proof for capabilities, evaluated core/conformance/human verdicts, and a nonzero product-findings digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign_id", "nonce", "status", "terminal_outcome", "terminal_reason", "bindings", "results"],
  "properties": {
    "schema": {"const": "factory-readiness-result/v3"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["complete", "infrastructure_ready", "findings", "human_blocked", "infrastructure_failure"]},
    "terminal_outcome": {"enum": ["pass", "plannable", "findings", "blocked", "infrastructure_failure"]},
    "terminal_reason": {"enum": ["none", "transport", "enrollment_policy_configuration", "protocol", "signature_trust", "manifest_integrity", "aggregate_missing_invalid", "capability_gate", "core_gate", "conformance_gate", "interrupted_acquisition", "human_authority", "generic_integrity_failure"]},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_commit", "tree", "environment_blob", "specification_sha256", "plan_sha256", "conformance_sha256", "policy_sha256", "readiness_policy_sha256", "contracts_sha256", "install_manifest_sha256", "command_authority_sha256", "human_authority_sha256", "trust_authority_sha256"],
      "properties": {
        "accepted_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"}, "tree": {"type":"string","pattern":"^[0-9a-f]{40}$"}, "environment_blob": {"type":"string","pattern":"^[0-9a-f]{40}$"},
        "specification_sha256":{"$ref":"#/$defs/sha256"}, "plan_sha256":{"$ref":"#/$defs/sha256"}, "conformance_sha256":{"$ref":"#/$defs/sha256"}, "policy_sha256":{"$ref":"#/$defs/sha256"}, "readiness_policy_sha256":{"$ref":"#/$defs/sha256"}, "contracts_sha256":{"$ref":"#/$defs/sha256"}, "install_manifest_sha256":{"$ref":"#/$defs/sha256"}, "command_authority_sha256":{"$ref":"#/$defs/sha256"}, "human_authority_sha256":{"$ref":"#/$defs/sha256"}, "trust_authority_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "results": {
      "type":"object", "additionalProperties":false,
      "required":["aggregate_sha256","findings_aggregate_sha256","capability_result_sha256","core_result_sha256","conformance_result_sha256","human_result_sha256","product_findings_sha256"],
      "properties":{"aggregate_sha256":{"$ref":"#/$defs/sha256"},"findings_aggregate_sha256":{"$ref":"#/$defs/sha256"},"capability_result_sha256":{"$ref":"#/$defs/sha256"},"core_result_sha256":{"$ref":"#/$defs/sha256"},"conformance_result_sha256":{"$ref":"#/$defs/sha256"},"human_result_sha256":{"$ref":"#/$defs/sha256"},"product_findings_sha256":{"$ref":"#/$defs/sha256"}}
    }
  },
  "$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
