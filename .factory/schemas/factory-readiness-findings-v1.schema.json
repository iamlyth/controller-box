{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-readiness-findings/v1",
  "title": "factory-readiness-findings",
  "description": "The round-1 authenticated readiness-findings artifact (BLOCKER 4). The trusted orchestrator mints one write-once artifact under the ignored .factory-state/ evidence namespace at the exact moment a round-zero readiness phase classifies as plannable with an authenticated signed failing baseline. The artifact binds the campaign id, the readiness nonce, the exact accepted commit, and the SHA-256 digest of the deterministic product-findings payload (a factory-findings/v1 payload whose source is the round-zero readiness phase, never a verification/audit round). Consumption is durable one-use: the artifact is re-validated against this committed schema and every binding (campaign id, readiness nonce, exact accepted commit, payload digest) before the round-1 planner receives the payload; a replay, wrong campaign/nonce/commit/digest, or malformed/missing artifact fails closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "readiness_nonce",
    "accepted_commit",
    "payload_sha256",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["factory-readiness-findings/v1"]
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "readiness_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "accepted_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "campaign_id", "source_round", "entries"],
      "properties": {
        "schema": {
          "type": "string",
          "enum": ["factory-findings/v1"]
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "source_round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "outcome", "findings", "blocked_on"],
            "properties": {
              "phase": {
                "type": "string",
                "enum": ["readiness"]
              },
              "outcome": {
                "type": "string",
                "enum": ["findings", "blocked"]
              },
              "findings": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "blocked_on": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
